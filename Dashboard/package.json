{
  "name": "apparel-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Label Reader — analytical dashboard. Server-rendered, bilingual, single SQLite file.",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
