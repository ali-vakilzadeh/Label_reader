    "helmet": "^8.1.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
