<%- include('partials/head') %>
<div class="card narrow">
  <h1>Change password</h1>
  <% if (forced) { %>
    <p class="notice">
      This account still uses the seeded password. Choose a new one before continuing —
      the dashboard will not let you past this page until you do.
    </p>
  <% } %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>New password<input name="password" type="password" autocomplete="new-password" required minlength="8"></label>
    <label>Repeat<input name="confirm" type="password" autocomplete="new-password" required minlength="8"></label>
    <p class="muted">At least 8 characters, with no leading or trailing space.</p>
    <button class="btn primary" type="submit">Save</button>
  </form>
</div>
<%- include('partials/foot') %>
