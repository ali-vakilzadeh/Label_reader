# Label Reader dashboard — configuration
# Copy to .env. Every value below is the default; none is secret except SESSION_SECRET.

# HTTP
DASHBOARD_PORT=3100
TRUST_PROXY=1

# Where the middleware keeps control.db / server_scans.db / flywheel.db.
# The dashboard and the middleware always run on the same host (plan §14.2).
MIDDLEWARE_DATA_DIR=/opt/apparel-middleware/data

# The client's taxonomy tables. Shared with the middleware so text and ids cannot drift.
REFERENCE_DATA_DIR=/opt/apparel-middleware/reference_data

# Dashboard-owned reference tables (custom_codes.csv, hs_map.csv, category.csv)
LOCAL_REFERENCE_DIR=./reference_data

# The dashboard's own database
DASHBOARD_DATA_DIR=./data

# Sessions. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-before-deploying
SESSION_TTL_HOURS=12

# Behaviour
DEFAULT_LOCALE=en
PAGE_SIZE=50
FUZZY_MIN_SIMILARITY=0.85
DUP_WINDOW_HOURS=24
LOW_CONFIDENCE_THRESHOLD=0.70
MAX_DASH_USERS=10
DEFAULT_CURRENCY=EUR

# Set to 0 once you are behind TLS-terminating nginx and want secure cookies enforced.
ALLOW_INSECURE_COOKIES=1
