# ---------------------------------------------------------------------------
# Apparel Vision Processing Middleware — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# Public hostname used to pre-generate deterministic catalog URLs.
# Must match the domain the VPS serves on, e.g. vps-domain.com
SERVER_HOST=vps-domain.com
PUBLIC_PROTOCOL=https

# --- Authentication (REQUIRED — server refuses to boot without these) -------
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Shared master device password entered in the Android app settings.
APP_MASTER_PASSWORD=
JWT_EXPIRES_IN=30d

# --- Gemini ----------------------------------------------------------------
# Stored exclusively here; never shipped to a device.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Transient 429/5xx and network faults are retried with exponential backoff.
GEMINI_MAX_ATTEMPTS=3
# Optional second model tried once after the primary exhausts its retries.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# --- Storage (relative paths resolve against the package root) --------------
DATA_DIR=data
UPLOADS_DIR=uploads
CATALOG_DIR=public/catalog

# --- Hidden training flywheel ----------------------------------------------
# Any field scoring below this routes the scan into flywheel.db.
FLYWHEEL_CONFIDENCE_THRESHOLD=0.85
# Strict FIFO ring-buffer ceiling.
FLYWHEEL_MAX_RECORDS=10000
# Optional shared secret for /api/v1/flywheel/* — when set, requests without a
# matching x-flywheel-key header get a 404. Leave empty to guard with JWT only.
FLYWHEEL_ADMIN_KEY=

# --- Limits ----------------------------------------------------------------
MAX_IMAGES=8
MAX_IMAGE_BYTES=12582912
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Login attempts per minute per IP. Sized for a whole fleet re-authenticating
# from one NAT after a password reset.
LOGIN_RATE_LIMIT_MAX=30
# Minimum length for operator passwords set through the Web UI.
PASSWORD_MIN_LENGTH=8
# Seeds three throwaway operator accounts (minelli / karen / ali, password =
# username) on a fresh install, so devices can be tested before the Web UI
# exists. Only fires when no accounts exist. SET THIS TO false BEFORE PRODUCTION.
SEED_TEST_ACCOUNTS=true
# Allow devices with no operator account to log in with APP_MASTER_PASSWORD.
# Set false once every device has its own account.
ALLOW_MASTER_PASSWORD_FALLBACK=true
# Comma-separated origins, or * for any.
CORS_ORIGIN=*

# --- Client polling hints (api_contract.md v1.1) ----------------------------
# Per-scan cost used to estimate queue wait shown to the operator.
VISION_SECONDS_PER_ITEM=5
# Floor/ceiling for the retry_after_seconds hint returned to devices.
POLL_RETRY_MIN_SECONDS=5
POLL_RETRY_MAX_SECONDS=120
# Maximum ids accepted by GET /api/v1/vision/results.
RESULTS_BATCH_LIMIT=100

# --- Overnight render cron -------------------------------------------------
RENDER_CRON_ENABLED=true
RENDER_CRON_SCHEDULE=0 20 * * *
RENDER_CRON_TIMEZONE=Asia/Yerevan
RENDER_BATCH_SIZE=200
# A failed render is retried on later nights until this many attempts.
RENDER_MAX_ATTEMPTS=3

# --- Control channel (shared control.db with the Web UI) -------------------
# See control_channel_contract.md. Raise both to 60000 for a 1-minute cadence.
CONTROL_HEARTBEAT_MS=30000
CONTROL_POLL_MS=15000
# Extraction backlog sweep.
QUEUE_DRAIN_MS=60000
QUEUE_DRAIN_BATCH=25
QUEUE_BACKLOG_WARNING=25

# debug | info | warn | error
LOG_LEVEL=info
